PORT=3000
MONGO_URI=mongodb://localhost:27017/devai_career_hub
JWT_SECRET=your_jwt_secret_here

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=your_bucket_name

RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@devai-career-hub.com
FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GITHUB_TOKEN=your_github_token

AI_RATE_LIMIT_PER_MINUTE_IP=15
AI_RATE_LIMIT_DAILY_AUTH=100

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Keep-alive self-ping to prevent Render free-tier spin-down (every 14 min).
# Set to "true" ONLY on Render free tier. Consumes ~730 of 750 shared monthly
# free hours — disable if you have other free services on the same account,
# or if you upgrade to a paid plan (where it's unnecessary).
ENABLE_KEEP_ALIVE=false
